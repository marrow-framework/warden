{% extends "layouts/app.html.twig" %}

{% block title %}Vérification en deux étapes{% endblock %}

{% block body %}
<div class="flex min-h-screen flex-col items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm">
        <h1 class="mb-4 text-center text-2xl font-semibold text-slate-50">Vérification en deux étapes</h1>
        <p class="mb-8 text-center text-sm text-slate-400">
            Entrez le code à 6 chiffres de votre application d'authentification, ou un code de récupération.
        </p>

        <form method="POST" action="{{ route('two-factor.verify') }}" class="space-y-5">
            {{ csrf_field()|raw }}

            <div>
                <label for="code" class="mb-1 block text-sm font-medium text-slate-300">Code</label>
                <input type="text" name="code" id="code" inputmode="numeric" autocomplete="one-time-code" required autofocus
                    class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-center text-lg tracking-widest text-slate-100 focus:border-orange-400 focus:outline-none">
                {% if has_error('code') %}
                    <p class="mt-1 text-sm text-red-400">{{ errors('code')[0] }}</p>
                {% endif %}
            </div>

            <button type="submit"
                class="w-full rounded-lg bg-orange-500 px-4 py-2 font-semibold text-slate-950 transition hover:bg-orange-400">
                Vérifier
            </button>
        </form>
    </div>
</div>
{% endblock %}
