{% extends "@auth/layouts/auth.html.twig" %}

{% block title %}Créer un compte{% endblock %}
{% block card_title %}Créer un compte{% endblock %}
{% block card_description %}Quelques informations pour commencer.{% endblock %}

{% block card_content %}
    <mui-form :form="form" action="{{ route('register.store') }}">
        {# Not a declared RegisterForm field — the `confirmed` rule checks
           it against the raw submitted data directly, see RegisterForm's
           own docblock. #}
        <mui-field
            name="password_confirmation" type="password" label="Confirmer le mot de passe"
            required :attrs="{autocomplete: 'new-password'}"
        />
        <mui-button type="submit" class="w-full">Créer mon compte</mui-button>
    </mui-form>
{% endblock %}

{% block card_footer %}
    <p class="text-center">Déjà inscrit ? <a href="{{ route('login') }}" class="hover:text-orange-300">Se connecter</a></p>
{% endblock %}
