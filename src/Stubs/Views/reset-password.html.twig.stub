{% extends "layouts/auth.html.twig" %}

{% block title %}Réinitialiser le mot de passe{% endblock %}
{% block card_title %}Réinitialiser le mot de passe{% endblock %}
{% block card_description %}Choisissez un nouveau mot de passe.{% endblock %}

{% block card_content %}
    <mui-form :form="form" action="{{ route('password.update') }}">
        {# Not a declared ResetPasswordForm field — see RegisterForm's docblock. #}
        <mui-field
            name="password_confirmation" type="password" label="Confirmer le mot de passe"
            required :attrs="{autocomplete: 'new-password'}"
        />
        <mui-button type="submit" class="w-full">Réinitialiser le mot de passe</mui-button>
    </mui-form>
{% endblock %}
