{% extends "layouts/app.html.twig" %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
<div class="flex min-h-screen flex-col items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm">
        <h1 class="mb-8 text-center text-2xl font-semibold text-slate-50">Réinitialiser le mot de passe</h1>

        {% set extra %}
            {# Not a declared ResetPasswordForm field — see RegisterForm's docblock. #}
            {{ component('field', {name: 'password_confirmation', type: 'password', label: 'Confirmer le mot de passe', required: true, attrs: {autocomplete: 'new-password'}}) }}
            {{ component('button', {type: 'submit', class: 'w-full', slot: 'Réinitialiser le mot de passe'}) }}
        {% endset %}

        {{ component('form', {form: form, action: route('password.update'), slot: extra}) }}
    </div>
</div>
{% endblock %}
