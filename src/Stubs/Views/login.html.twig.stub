{% extends "layouts/auth.html.twig" %}

{% block title %}Connexion{% endblock %}
{% block card_title %}Connexion{% endblock %}
{% block card_description %}Accédez à votre espace.{% endblock %}

{% block card_content %}
    {% if session_flash('status') %}
        <mui-alert type="success" class="mb-6">{{ session_flash('status') }}</mui-alert>
    {% endif %}

    <mui-form :form="form" action="{{ route('login.attempt') }}">
        <div class="mb-5">
            <mui-checkbox name="remember" value="1" label="Se souvenir de moi" />
        </div>
        <mui-button type="submit" class="w-full">Se connecter</mui-button>
    </mui-form>
{% endblock %}

{% block card_footer %}
    <div class="flex items-center justify-between">
        <a href="{{ route('password.request') }}" class="hover:text-orange-300">Mot de passe oublié ?</a>
        <a href="{{ route('register') }}" class="hover:text-orange-300">Créer un compte</a>
    </div>
{% endblock %}
