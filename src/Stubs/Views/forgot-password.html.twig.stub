{% extends "layouts/app.html.twig" %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="flex min-h-screen flex-col items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm">
        <h1 class="mb-4 text-center text-2xl font-semibold text-slate-50">Mot de passe oublié</h1>
        <p class="mb-8 text-center text-sm text-slate-400">
            Indiquez votre adresse email, nous vous enverrons un lien de réinitialisation.
        </p>

        {% if session_flash('status') %}
            {% component 'alert' with {type: 'success'} %}{{ session_flash('status') }}{% endcomponent %}
            <div class="mb-6"></div>
        {% endif %}

        {% set submit %}{{ component('button', {type: 'submit', class: 'w-full', slot: 'Envoyer le lien de réinitialisation'}) }}{% endset %}
        {{ component('form', {form: form, action: route('password.email'), slot: submit}) }}

        <div class="mt-6 text-center text-sm text-slate-400">
            <a href="{{ route('login') }}" class="hover:text-orange-300">Retour à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}
