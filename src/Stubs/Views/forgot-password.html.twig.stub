{% extends "layouts/auth.html.twig" %}

{% block title %}Mot de passe oublié{% endblock %}
{% block card_title %}Mot de passe oublié{% endblock %}
{% block card_description %}Indiquez votre adresse email, nous vous enverrons un lien de réinitialisation.{% endblock %}

{% block card_content %}
    {% if session_flash('status') %}
        <mui-alert type="success" class="mb-6">{{ session_flash('status') }}</mui-alert>
    {% endif %}

    <mui-form :form="form" action="{{ route('password.email') }}">
        <mui-button type="submit" class="w-full">Envoyer le lien de réinitialisation</mui-button>
    </mui-form>
{% endblock %}

{% block card_footer %}
    <p class="text-center"><a href="{{ route('login') }}" class="hover:text-orange-300">Retour à la connexion</a></p>
{% endblock %}
