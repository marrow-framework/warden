{% extends "layouts/auth.html.twig" %}

{% block title %}Vérifiez votre email{% endblock %}
{% block wrapper_class %}max-w-md{% endblock %}
{% block card_title %}Vérifiez votre adresse email{% endblock %}
{% block card_description %}
    Un lien de confirmation vous a été envoyé par email lors de votre inscription.
    Cliquez dessus pour activer votre compte.
{% endblock %}

{% block card_content %}
    {% if session_flash('status') %}
        <mui-alert type="success" class="mb-6">{{ session_flash('status') }}</mui-alert>
    {% endif %}

    {% if has_error('email') %}
        <mui-alert type="danger" class="mb-6">{{ errors('email')[0] }}</mui-alert>
    {% endif %}

    <mui-form action="{{ route('verification.send') }}" class="text-center">
        <mui-button type="submit">Renvoyer l'email de confirmation</mui-button>
    </mui-form>
{% endblock %}
