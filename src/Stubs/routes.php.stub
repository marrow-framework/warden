<?php

declare(strict_types=1);

/**
 * Generated by `php forge warden:install`. Fully yours to edit.
 *
 * Loaded by BaseModule::loadRoutes() with $router already in scope
 * (see ModuleManager::bootModule()) — no `use` import needed for it.
 *
 * @var \Marrow\Routing\Router $router
 */

use Modules\Auth\Controllers\ForgotPasswordController;
use Modules\Auth\Controllers\LoginController;
use Modules\Auth\Controllers\RegisterController;
use Modules\Auth\Controllers\ResetPasswordController;
use Modules\Auth\Controllers\TwoFactorChallengeController;
use Modules\Auth\Controllers\VerifyEmailController;

// Guest-only: the login/register/password-reset/2FA-challenge forms.
$router->group(['middleware' => ['web', 'guest']], function () use ($router) {
    $router->get('/login', [LoginController::class, 'show'])->name('login');
    $router->post('/login', [LoginController::class, 'login'])->name('login.attempt')->throttle(10, 1);

    $router->get('/register', [RegisterController::class, 'show'])->name('register');
    $router->post('/register', [RegisterController::class, 'register'])->name('register.store')->throttle(10, 1);

    $router->get('/forgot-password', [ForgotPasswordController::class, 'show'])->name('password.request');
    $router->post('/forgot-password', [ForgotPasswordController::class, 'send'])->name('password.email')->throttle(5, 1);

    $router->get('/reset-password', [ResetPasswordController::class, 'show'])->name('password.reset');
    $router->post('/reset-password', [ResetPasswordController::class, 'reset'])->name('password.update')->throttle(10, 1);

    // Reached only via LoginController::login() parking a pending user id in
    // the session — see TwoFactorChallengeController's docblock.
    $router->get('/two-factor-challenge', [TwoFactorChallengeController::class, 'show'])->name('two-factor.challenge');
    $router->post('/two-factor-challenge', [TwoFactorChallengeController::class, 'verify'])->name('two-factor.verify')->throttle(10, 1);
});

$router->post('/logout', [LoginController::class, 'logout'])->name('logout')->middleware(['web', 'auth']);

// Authenticated: email verification. Deliberately NOT behind the `verified`
// middleware itself — gate your own routes with it once you need to, e.g.
// ->middleware(['auth', 'verified']) (see Middleware/EnsureEmailIsVerified.php).
$router->group(['middleware' => ['web', 'auth']], function () use ($router) {
    $router->get('/email/verify', [VerifyEmailController::class, 'notice'])->name('verification.notice');
    $router->get('/email/verify/{id}/{token}', [VerifyEmailController::class, 'verify'])->name('verification.verify');
    $router->post('/email/verification-notification', [VerifyEmailController::class, 'resend'])
        ->name('verification.send')
        ->throttle(3, 1);
});
