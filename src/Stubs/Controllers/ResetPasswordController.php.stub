<?php

declare(strict_types=1);

namespace Modules\Auth\Controllers;

use Marrow\Auth\Hash;
use Marrow\Database\Connection;
use Marrow\Http\Controller;
use Marrow\Http\Request;
use Marrow\Warden\PasswordResetBroker;
use Modules\Auth\Forms\ResetPasswordForm;
use Symfony\Component\HttpFoundation\Response;

class ResetPasswordController extends Controller
{
    /**
     * `fromRequest()` picks up `token`/`email` from the query string (the
     * link the user clicked) via Request::all(), which merges query +
     * request body — see ForgotPasswordController's mailed URL.
     */
    public function show(Request $request): Response
    {
        return $this->showForm(ResetPasswordForm::fromRequest($request));
    }

    /** See LoginController::login()'s docblock for why this is Symfony's Response, not Marrow\Http\Response. */
    public function reset(Request $request, Connection $db, PasswordResetBroker $broker): Response
    {
        $form = ResetPasswordForm::fromRequest($request);
        if (!$form->isValid()) {
            return $this->showForm($form);
        }

        $data = $form->cleanedData();

        if (!$broker->consume($data['email'], $data['token'])) {
            $form->field('email')->errors = ['Ce lien de réinitialisation est invalide ou a expiré.'];
            return $this->showForm($form);
        }

        $db->update('users', ['password' => Hash::make($data['password'])], ['email' => $data['email']]);

        return $this->redirectToRoute('login')->with(
            'status',
            'Votre mot de passe a été réinitialisé — vous pouvez vous connecter.'
        );
    }

    private function showForm(ResetPasswordForm $form): \Marrow\Http\Response
    {
        return $this->view('@auth/reset-password', ['form' => $form]);
    }
}
