<?php

declare(strict_types=1);

namespace Modules\Auth\Controllers;

use Marrow\Auth\Hash;
use Marrow\Database\Connection;
use Marrow\Http\Controller;
use Marrow\Http\RedirectResponse;
use Marrow\Http\Request;
use Marrow\Http\Response;
use Marrow\Warden\PasswordResetBroker;

class ResetPasswordController extends Controller
{
    public function show(Request $request): Response
    {
        return $this->view('@auth/reset-password', [
            'token' => (string) $request->input('token', ''),
            'email' => (string) $request->input('email', ''),
        ]);
    }

    public function reset(Request $request, Connection $db, PasswordResetBroker $broker): RedirectResponse
    {
        $data = $this->validate($request, [
            'token' => 'required|string',
            'email' => 'required|email',
            'password' => 'required|string|min:8|confirmed',
        ]);

        if (!$broker->consume($data['email'], $data['token'])) {
            return $this->back()->withErrors([
                'email' => ['Ce lien de réinitialisation est invalide ou a expiré.'],
            ]);
        }

        $db->update('users', ['password' => Hash::make($data['password'])], ['email' => $data['email']]);

        return $this->redirectToRoute('login')->with(
            'status',
            'Votre mot de passe a été réinitialisé — vous pouvez vous connecter.'
        );
    }
}
