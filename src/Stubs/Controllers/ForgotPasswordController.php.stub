<?php

declare(strict_types=1);

namespace Modules\Auth\Controllers;

use Marrow\Database\Connection;
use Marrow\Http\Controller;
use Marrow\Http\Request;
use Marrow\Mail\Mailer;
use Marrow\Warden\Mail\ResetPasswordMail;
use Marrow\Warden\PasswordResetBroker;
use Modules\Auth\Forms\ForgotPasswordForm;
use Symfony\Component\HttpFoundation\Response;

class ForgotPasswordController extends Controller
{
    /** Minutes a reset link stays valid — keep in sync with PasswordResetBroker's ttlSeconds. */
    private const EXPIRES_IN_MINUTES = 60;

    public function show(): Response
    {
        return $this->showForm(new ForgotPasswordForm());
    }

    /** See LoginController::login()'s docblock for why this is Symfony's Response, not Marrow\Http\Response. */
    public function send(Request $request, Connection $db, PasswordResetBroker $broker, Mailer $mailer): Response
    {
        $form = ForgotPasswordForm::fromRequest($request);
        if (!$form->isValid()) {
            return $this->showForm($form);
        }

        $data = $form->cleanedData();

        $row = $db->selectOne('SELECT * FROM users WHERE email = ?', [$data['email']]);

        // Always the same message regardless of whether the account exists —
        // same account-enumeration defense as SessionGuard::attempt()'s
        // constant-time dummy-hash check (see docs/authentication.md).
        if ($row !== null) {
            $token = $broker->createToken($data['email']);
            $resetUrl = $this->router->route('password.reset') . '?' . http_build_query([
                'token' => $token,
                'email' => $data['email'],
            ]);

            $mailer->send(new ResetPasswordMail($data['email'], $resetUrl, self::EXPIRES_IN_MINUTES));
        }

        return $this->back()->with(
            'status',
            'Si un compte existe pour cette adresse, un lien de réinitialisation vient de lui être envoyé.'
        );
    }

    private function showForm(ForgotPasswordForm $form): \Marrow\Http\Response
    {
        return $this->view('@auth/forgot-password', ['form' => $form]);
    }
}
