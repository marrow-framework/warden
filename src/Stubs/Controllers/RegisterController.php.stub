<?php

declare(strict_types=1);

namespace Modules\Auth\Controllers;

use Marrow\Auth\AuthManager;
use Marrow\Auth\Hash;
use Marrow\Http\Controller;
use Marrow\Http\Request;
use Marrow\Http\Response;
use Modules\Account\Models\User;
use Modules\Auth\Forms\RegisterForm;

class RegisterController extends Controller
{
    public function show(): Response
    {
        return $this->showForm(new RegisterForm());
    }

    public function register(Request $request, AuthManager $auth): Response
    {
        $form = RegisterForm::fromRequest($request);
        if (!$form->isValid()) {
            return $this->showForm($form);
        }

        $data = $form->cleanedData();

        $user = User::create([
            'name' => $data['name'],
            'email' => $data['email'],
            'password' => Hash::make($data['password']),
        ]);

        $auth->login($user);

        return $this->redirectToRoute('home');
    }

    private function showForm(RegisterForm $form): Response
    {
        return $this->view('@auth/register', ['form' => $form]);
    }
}
