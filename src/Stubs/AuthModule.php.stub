<?php

declare(strict_types=1);

namespace Modules\Auth;

use Marrow\Module\Attributes\Module;
use Marrow\Module\BaseModule;

/**
 * Generated by `php forge warden:install`.
 *
 * Fully yours to edit from here on — everything under modules/Auth/
 * (controllers, middleware, views, migrations, routes) is now part of your
 * app's own source, not marrow/warden's. The package itself only keeps the
 * small, versioned pieces that are awkward to hand-roll safely: token
 * hashing/signing (PasswordResetBroker, EmailVerifier, RememberMeBroker) and
 * the two transactional emails (Marrow\Warden\Mail\*).
 */
#[Module(name: 'auth')]
class AuthModule extends BaseModule
{
    public function boot(): void
    {
        $this->registerViewNamespace('auth', $this->path('Views'));
        $this->loadRoutes($this->path('routes.php'));
    }
}
