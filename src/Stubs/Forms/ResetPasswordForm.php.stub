<?php

declare(strict_types=1);

namespace Modules\Auth\Forms;

use Marrow\FormBuilder\Fields\EmailField;
use Marrow\FormBuilder\Fields\HiddenField;
use Marrow\FormBuilder\Fields\PasswordField;
use Marrow\FormBuilder\Form;

/**
 * `token` is a HiddenField purely for its rendering (no label/wrapper, see
 * marrow/ui's `form` bridge) — HiddenField still validates like any other
 * Field, so `rules: 'required'` is enforced the same way.
 *
 * No declared field for `password_confirmation` — see RegisterForm's
 * docblock.
 */
class ResetPasswordForm extends Form
{
    #[HiddenField(rules: 'required')]
    public string $token;

    #[EmailField(label: 'Email', rules: 'required|email')]
    public string $email;

    #[PasswordField(label: 'Nouveau mot de passe', rules: 'required|string|min:8|confirmed')]
    public string $password;
}
